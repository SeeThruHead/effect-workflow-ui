{
  "name": "effect-workflow-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*",
    "vendor/spar/packages/spar",
    "vendor/spar/packages/lint"
  ],
  "scripts": {
    "ci": "dagger call check --source .",
    "prepare": "lefthook install",
    "moon": "moon",
    "check": "moon run :check",
    "check:affected": "moon run :check --affected",
    "storybook": "bun run --cwd packages/ui storybook",
    "design": "bun run --cwd apps/workflow-design start"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@moonrepo/cli": "2.6.4",
    "lefthook": "2.2.2",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  }
}
