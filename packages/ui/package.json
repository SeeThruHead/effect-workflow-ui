{
  "name": "@effect-workflow/ui",
  "version": "0.1.0",
  "description": "Foldkit components and StyleX tokens for viewing Effect workflow and Effect cluster runs. Ships TypeScript source with StyleX calls intact; compile it with your own @stylexjs/unplugin.",
  "repository": "https://github.com/SeeThruHead/effect-workflow-ui",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.ts",
    "!src/stories"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./base.css": "./src/theme/base.css",
    "./testing/stylex": "./src/testing/stylex.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings -c ../../tooling/lint/oxlintrc.json src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest run",
    "storybook": "storybook dev --port 6008 --no-open",
    "storybook:build": "storybook build --output-dir dist/storybook",
    "pack:check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.4",
    "@storybook/html-vite": "10.6.2",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/bun": "1.4.4",
    "@vitest/coverage-istanbul": "5.0.5",
    "effect": "4.1.4",
    "foldkit": "0.170.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.91.0",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "0.19.1",
    "effect": "4.1.4",
    "foldkit": "0.170.0"
  }
}
