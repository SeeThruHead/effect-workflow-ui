{
  "name": "@effect-workflow/lint",
  "private": true,
  "type": "module",
  "exports": {
    "./coverage": "./coverage.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings -c oxlintrc.json .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.4",
    "@types/bun": "1.4.4",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
